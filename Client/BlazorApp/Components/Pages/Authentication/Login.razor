@page "/login"
@using BlazorApp.Auth
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavMgr

<PageTitle>Log in</PageTitle>

<div class="narrow">
    <AuthorizeView>
        <NotAuthorized>
            <h1>Log in</h1>
            <p class="muted">Log in to write posts and reply to them.</p>

            <div class="panel">
                <div class="form">
                    <label>
                        Username
                        <input type="text" @bind="userName" />
                    </label>
                    <label>
                        Password
                        <input type="password" @bind="password" />
                    </label>
                    <button @onclick="LoginAsync">Log in</button>
                </div>

                @if (!string.IsNullOrEmpty(errorLabel))
                {
                    <p class="notice error">@errorLabel</p>
                }
            </div>

            <p class="muted small" style="margin-top: 1rem;">No account yet? <a href="users/create">Create a user</a>.</p>
        </NotAuthorized>
        <Authorized>
            <h1>Hello, @context.User.Identity?.Name</h1>
            <p class="muted">You're logged in.</p>
            <a class="button" href="posts">Browse posts</a>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private string userName = "";
    private string password = "";
    private string errorLabel = "";

    private async Task LoginAsync()
    {
        errorLabel = "";
        try
        {
            // the injected one is our SimpleAuthProvider, Login lives only there
            await ((SimpleAuthProvider)AuthProvider).Login(userName, password);
            NavMgr.NavigateTo("/");
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            errorLabel = $"Error: {e.Message}";
        }
    }
}
